# ==========================================
# Multimodal Attendance & Engagement Agent
# Root Environment Variables Configuration
# ==========================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./attendance_agent.db

# Multimodal Agent Perception Thresholds
ATTENTION_THRESHOLD=0.60
DROWSINESS_THRESHOLD=0.35
AUDIO_SPEECH_THRESHOLD=0.08

# Multimodal Fusion Formula Weights (Must sum to 1.0)
ENGAGEMENT_FUSION_VISION_WEIGHT=0.60
ENGAGEMENT_FUSION_AUDIO_WEIGHT=0.40

# Demo Dataset Auto-Seeding
AUTO_SEED_DEMO_DATA=true
SECRET_KEY=dev-multimodal-agent-secret-key-change-in-production

# Frontend API Target
VITE_API_URL=http://localhost:8000

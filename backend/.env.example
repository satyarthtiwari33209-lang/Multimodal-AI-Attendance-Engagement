# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./attendance_agent.db

# Multimodal Agent Settings
ATTENTION_THRESHOLD=0.60
DROWSINESS_THRESHOLD=0.35
AUDIO_SPEECH_THRESHOLD=0.08
ENGAGEMENT_FUSION_VISION_WEIGHT=0.60
ENGAGEMENT_FUSION_AUDIO_WEIGHT=0.40

# Demo Simulation & Seeding
AUTO_SEED_DEMO_DATA=true
SECRET_KEY=dev-multimodal-agent-secret-key-change-in-production
